# GoVan server configuration
GOVAN_ENV=development
GOVAN_SECRET_KEY=replace-with-a-cryptographically-random-secret-before-deployment
GOVAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DATABASE_URL=sqlite:///./govan.db
# Optional OSRM-compatible endpoint; blank uses explicit straight-line fallback
ROUTING_BASE_URL=
ROUTING_TIMEOUT_SECONDS=2.5
# Demo only: low, moderate, or heavy (illustrative; not measured Lahore traffic)
TRAFFIC_SCENARIO=
